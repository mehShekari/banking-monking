{"nodes": [{"id": "claude_skills_gsap_creative_animation_reference_flip", "label": "Flip Reference", "file_type": "document", "source_file": ".claude/skills/gsap-creative-animation/reference/flip.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_gsap_creative_animation_reference_flip_flip_plugin", "label": "Flip Plugin (getState / from)", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/flip.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use when the motion's meaning is continuity: this thing is still that thing."}, {"id": "claude_skills_gsap_creative_animation_reference_flip_flip_options", "label": "Flip Options: absolute, scale, nested, onEnter/onLeave", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/flip.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "absolute prevents sibling reflow jitter; scale is GPU-friendly but scales borders/text."}, {"id": "claude_skills_gsap_creative_animation_reference_flip_data_flip_id", "label": "data-flip-id Shared Element Matching", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/flip.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_gsap_creative_animation_reference_flip_hold_container_height", "label": "Release Held Height on Flip's onComplete", "file_type": "rationale", "source_file": ".claude/skills/gsap-creative-animation/reference/flip.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parent timeline ends when its longest child ends, so releasing on the parent produces a one-frame collapse when a sibling is missing; tie release to