{"nodes": [{"id": "claude_skills_gsap_creative_animation_reference_core_gsap", "label": "Core Gsap Reference", "file_type": "document", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_four_verbs", "label": "gsap.to / from / fromTo / set", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "from causes a flash because the element paints before the tween applies; fromTo or a prior set removes it."}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_subpath_plugin_imports", "label": "Subpath Plugin Imports and registerPlugin", "file_type": "rationale", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Import each plugin from its own subpath (never gsap/all) so bundlers drop unused ones; registering useGSAP makes GSAP warn about missing plugins."}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_autoalpha", "label": "autoAlpha (opacity + visibility)", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_css_variable_tweening", "label": "Tweening CSS Variables", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_overwrite_auto", "label": "overwrite: \"auto\"", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixes the hover bug where fast leave/re-enter leaves an element halfway."}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_gsap_utils", "label": "gsap.utils Helpers", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_quickto_quicksetter", "label": "gsap.quickTo / quickSetter", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One retargeted tween per high-frequency event avoids garbage allocation and fighting tweens; the single most important performance tool for pointer work."}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_gsap_matchmedia", "label": "gsap.matchMedia", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reverts everything created in the callback when a condition stops matching, unlike a plain window.matchMedia check; inside useGSAP/gsap.context it reverts with that context (verified gsap 3.15)."}, {"id": "claude_skills_gsap_creative_animation_reference_core_gsap_gsap_context", "label": "gsap.context (scope and revert)", "file_type": "concept", "source_file": ".claude/skills/gsap-creative-animation/reference/core-gsap.md", "source_location": null, "source_url": null, "captur